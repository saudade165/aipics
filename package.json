{
  "name": "aether-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI generation platform foundation: Next.js web app + FastAPI backend.",
  "scripts": {
    "setup": "npm run setup:web && npm run setup:api",
    "setup:web": "npm install --prefix apps/web",
    "setup:api": "python3 -m venv apps/api/.venv && apps/api/.venv/bin/pip install -r apps/api/requirements-dev.txt",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "apps/api/.venv/bin/uvicorn app.main:app --app-dir apps/api --reload --reload-dir apps/api/app --port 8000",
    "build": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "start:api": "apps/api/.venv/bin/uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8000 --workers 2",
    "lint": "npm run lint --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "test:api": "cd apps/api && .venv/bin/pytest -q"
  }
}
