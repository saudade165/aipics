{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "apps/api", "--port", "8000", "--reload", "--reload-dir", "apps/api/app"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "/opt/homebrew/opt/node@22/bin/npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3000
    }
  ]
}
