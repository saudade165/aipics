# ── Web (copy to apps/web/.env.local) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── API (copy to apps/api/.env) ──────────────────────────────────────────────
APP_NAME="Aether Studio API"
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO
DOCS_ENABLED=true              # set false to hide /docs in production
CORS_ORIGINS=http://localhost:3000

# Feature flags. A feature is active only when its flag is true AND a provider
# adapter is registered in apps/api/app/providers/registry.py.
AI_IMAGE_ENABLED=false
AI_VIDEO_ENABLED=false
AI_CHARACTER_ENABLED=false
AI_UPSCALE_ENABLED=false
AI_VIDEO_ENHANCE_ENABLED=false
AUTH_ENABLED=false
PAYMENTS_ENABLED=false
TOKEN_WALLET_ENABLED=false
DATABASE_ENABLED=false
STORAGE_ENABLED=false
QUEUE_ENABLED=false
